# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/

# Jupyter
.ipynb_checkpoints/

# Generated artefacts (regenerated by scripts/run_all.py -- not tracked so
# reviewers always see freshly-produced output, not stale committed files)
data/processed/
outputs/logs/*.log

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Keep the bundled raw dataset and figures/tables (tracked intentionally)
!data/raw/german.csv
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
